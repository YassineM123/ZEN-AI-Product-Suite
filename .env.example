# Global Portfolio Demo Mode (Set to true to run all apps with high-fidelity demo datasets)
ZEN_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 1. AI Model Providers (Shared)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Product 01 — ZEN Market Intelligence
# ------------------------------------------------------------------------------
MARKET_DATA_API_KEY=your_market_data_api_key
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINANCIAL_DATASETS_API_KEY=your_financial_datasets_key
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini
TRADINGAGENTS_DEEP_THINK_LLM=o3-mini

# ------------------------------------------------------------------------------
# 3. Product 02 — ZEN Commerce Intelligence
# ------------------------------------------------------------------------------
ORCHESTRATOR_URL=http://localhost:8080
DATABASE_URL=postgresql://zen_admin:zen_secure_password@localhost:5432/zen_commerce
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# 4. Product 03 — ZEN Sales Agent (WhatsApp & Instagram)
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
WORKOS_API_KEY=your_workos_api_key
WORKOS_CLIENT_ID=your_workos_client_id
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
